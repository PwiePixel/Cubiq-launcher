pkgbase = cubiq-launcher-bin
	pkgdesc = Minecraft launcher for every version and mod loader (Fabric, Quilt, Forge, NeoForge) with Modrinth, CurseForge, modpacks and the Cubiq Client
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/PwiePixel/Cubiq-launcher
	arch = x86_64
	license = GPL-3.0-only
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = glib2
	depends = cairo
	depends = gdk-pixbuf2
	depends = pango
	depends = libsoup3
	depends = openssl
	depends = dbus
	depends = hicolor-icon-theme
	depends = gcc-libs
	depends = glibc
	optdepends = xorg-xrandr: required by Minecraft 1.12.2 and older (LWJGL 2)
	optdepends = gnome-keyring: keep the sign-in key in the system keyring (or any Secret Service, e.g. KWallet)
	optdepends = java-runtime: use your own Java instead of the runtimes the launcher downloads
	optdepends = gamemode: use gamemoderun as launch wrapper
	optdepends = xdg-utils: open folders and links
	provides = cubiq-launcher
	conflicts = cubiq-launcher
	noextract = cubiq-launcher-0.1.0_amd64.deb
	options = !strip
	options = !debug
	source_x86_64 = cubiq-launcher-0.1.0_amd64.deb::https://github.com/PwiePixel/Cubiq-launcher/releases/download/v0.1.0/Cubiq-Launcher_0.1.0_amd64.deb
	sha256sums_x86_64 = SKIP

pkgname = cubiq-launcher-bin
